---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import PostCard from '../components/PostCard.astro';
import { defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = (Astro.currentLocale || defaultLang) as Lang;
const t = useTranslations(lang);

const posts = (await getCollection('posts'))
  .filter(post => !post.data.draft && post.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={t('index.title')}>
  <div class="index-content framed">
    <h1 id="hello-there">{t('index.hello')}</h1>
    <p set:html={t('index.intro')} />
    <p set:html={t('index.built')} />
    <p>{t('index.ai')}</p>
    <p set:html={t('index.findMe').replace('{contactUrl}', getRelativeLocaleUrl(lang, 'contact'))} />
  </div>
  
  <div class="posts">
    <div>
      <h4 class="post-title">{t('post.recentPosts')}</h4>
    </div>
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
