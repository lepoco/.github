---
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';
import { defaultLang, type Lang } from '../i18n/ui';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: Lang;
}

const lang = (Astro.currentLocale || defaultLang) as Lang;
const t = useTranslations(lang);
const { title, description = 'Leszek Pomianowski - .NET developer, open-source contributor, creator of WPF UI', image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const altLang = lang === 'en' ? 'pl' : 'en';

// Strip the current locale prefix from the path to get the base route
const currentPath = Astro.url.pathname.replace(/^\/(pl)(\/|$)/, '/').replace(/\/$/, '') || '/';
const pathSegment = currentPath === '/' ? '' : currentPath.replace(/^\//, '');
const altUrl = new URL(getRelativeLocaleUrl(altLang, pathSegment), Astro.site);
const defaultUrl = new URL(getRelativeLocaleUrl(defaultLang, pathSegment), Astro.site);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} /> -->
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preload and load Fira Code font optimally -->
    <link rel="preconnect" href="https://cdn.staticdelivr.com" crossorigin />
    <link rel="preload" href="https://cdn.staticdelivr.com/gfonts/css2?family=Fira+Code:wght@300..700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://cdn.staticdelivr.com/gfonts/css2?family=Fira+Code:wght@300..700&display=swap" /></noscript>
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {image && <meta property="og:image" content={new URL(image, Astro.url)} />}
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={new URL(image, Astro.url)} />}
    
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={getRelativeLocaleUrl(lang, 'rss.xml')} />
  </head>
  <body>
    <div class="container center">
      <header class="header">
        <div class="header__inner">
          <div class="header__logo">
            <a href={getRelativeLocaleUrl(lang, '')}>
              <div class="logo">
                lepo.co
              </div>
            </a>
          </div>
          <div class="header__controls">
            <a href={altUrl.pathname} class="lang-switch" title={altLang === 'pl' ? 'Polski' : 'English'}>
              {altLang}
            </a>
            <div class="theme-toggle" id="theme-toggle" title={t('theme.toggleTitle')}>
              <span class="theme-text">{t('theme.toggle')}</span>
            </div>
          </div>
          <ul class="menu menu--mobile">
            <li class="menu__trigger">{t('nav.menuTrigger')}</li>
            <li>
              <ul class="menu__dropdown">
                <li><a href={getRelativeLocaleUrl(lang, 'about')}>{t('nav.about')}</a></li>
                <li><a href={getRelativeLocaleUrl(lang, 'posts')}>{t('nav.blog')}</a></li>
                <li><a href={getRelativeLocaleUrl(lang, 'support')}>{t('nav.support')}</a></li>
                <li><a href={getRelativeLocaleUrl(lang, 'contact')}>{t('nav.contact')}</a></li>
                <li><a href={getRelativeLocaleUrl(lang, 'tags')}>{t('nav.tags')}</a></li>
                <li><a href="https://github.com/lepoco" target="_blank">{t('nav.github')}</a></li>
                <li><a href="https://github.com/sponsors/pomianowski" target="_blank">{t('nav.sponsor')}</a></li>
              </ul>
            </li>
          </ul>
        </div>
        
        <nav class="navigation-menu">
          <ul class="navigation-menu__inner menu--desktop">
            <li><a href={getRelativeLocaleUrl(lang, 'about')}>{t('nav.about')}</a></li>
            <li><a href={getRelativeLocaleUrl(lang, 'posts')}>{t('nav.blog')}</a></li>
            <li><a href={getRelativeLocaleUrl(lang, 'support')}>{t('nav.support')}</a></li>
            <li><a href={getRelativeLocaleUrl(lang, 'contact')}>{t('nav.contact')}</a></li>
            <li><a href={getRelativeLocaleUrl(lang, 'tags')}>{t('nav.tags')}</a></li>
            <li>
              <ul class="menu">
                <li class="menu__trigger">{t('nav.projects')}</li>
                <li>
                  <ul class="menu__dropdown">
                    <li><a href="https://github.com/lepoco/wpfui" target="_blank">WPF UI</a></li>
                    <li><a href="https://partner.microsoft.com/en-us/dashboard/products/9NH1P86H06CG/overview" target="_blank">Radiograph</a></li>
                    <li><a href="https://github.com/redfoxdb/documentdb" target="_blank">RedFox DocumentDB</a></li>
                    <li><a href="https://github.com/lepoco/openapi.client" target="_blank">OpenAPI MCP</a></li>
                    <li><a href="https://github.com/lepoco/mcp-camunda" target="_blank">Camunda MCP</a></li>
                    <li><a href="https://github.com/lepoco" target="_blank">{t('nav.allProjects')}</a></li>
                  </ul>
                </li>
              </ul>
            </li>
            <li><a href="https://github.com/sponsors/pomianowski" target="_blank">{t('nav.sponsor')}</a></li>
          </ul>
        </nav>
      </header>
      
      <main class="content">
        <slot />
      </main>
      
      <footer class="footer">
        <div class="footer__inner">
          <div class="copyright">
            <span>{t('footer.copyright').replace('{year}', String(new Date().getFullYear()))} <a href="https://github.com/lepoco" target="_blank">Leszek Pomianowski</a></span>
            <span class="separator">::</span>
            <span>{t('footer.themeMadeBy')} <a href="https://github.com/panr/hugo-theme-terminal" target="_blank">panr</a></span>
            <span class="separator">::</span>
            <span>{t('footer.portedBy')} <a href="https://github.com/dennisklappe">Dennis Klappe</a></span>
          </div>
        </div>
      </footer>
    </div>
    
    <script>
      // Theme toggle functionality
      (() => {
        const themeToggle = document.getElementById('theme-toggle');
        const root = document.documentElement;
        
        // Check for saved theme preference or default to auto
        const savedTheme = localStorage.getItem('theme');
        
        function setTheme(theme: any) {
          if (theme === 'dark') {
            root.style.setProperty('--background', '#1b1b1f');
            root.style.setProperty('--foreground', '#e3e3e3');
            root.style.setProperty('--accent', '#8fa882');
            root.setAttribute('data-theme', 'dark');
          } else if (theme === 'light') {
            root.style.setProperty('--background', '#ffffff');
            root.style.setProperty('--foreground', '#000000');
            root.style.setProperty('--accent', '#6b7f5c');
            root.setAttribute('data-theme', 'light');
          } else {
            // Auto mode - remove custom properties to use CSS media queries
            root.style.removeProperty('--background');
            root.style.removeProperty('--foreground');
            root.style.removeProperty('--accent');
            root.setAttribute('data-theme', 'auto');
          }
          localStorage.setItem('theme', theme);
        }
        
        // Apply saved theme or default to auto
        if (savedTheme) {
          setTheme(savedTheme);
        } else {
          setTheme('auto');
        }
        
        // Theme toggle click handler
        if (themeToggle) {
          themeToggle.addEventListener('click', () => {
            const currentTheme = localStorage.getItem('theme') || 'auto';
            let nextTheme;
            
            if (currentTheme === 'auto') {
              nextTheme = 'light';
            } else if (currentTheme === 'light') {
              nextTheme = 'dark';
            } else {
              nextTheme = 'auto';
            }
            
            setTheme(nextTheme);
          });
        }
      })();

      // Menu functionality
      (() => {
        const container = document.querySelector(".container");
        const menus = document.querySelectorAll(".menu");
        
        // Close menus when clicking outside
        document.body.addEventListener("click", () => {
          menus.forEach(menu => {
            if (menu.classList.contains("open")) {
              menu.classList.remove("open");
            }
          });
        });
        
        // Close menus on window resize
        window.addEventListener("resize", () => {
          menus.forEach(menu => {
            menu.classList.remove("open");
          });
        });
        
        // Menu trigger functionality
        menus.forEach(menu => {
          const trigger = menu.querySelector(".menu__trigger");
          const dropdown = menu.querySelector(".menu__dropdown");
          
          if (trigger && dropdown) {
            trigger.addEventListener("click", event => {
              event.stopPropagation();
              
              if (menu.classList.contains("open")) {
                menu.classList.remove("open");
              } else {
                // Close other menus
                menus.forEach(m => m.classList.remove("open"));
                menu.classList.add("open");
              }
              
              // Adjust dropdown position if it goes outside container
              if (container && dropdown.getBoundingClientRect().right > container.getBoundingClientRect().right) {
                (dropdown as HTMLElement).style.left = "auto";
                (dropdown as HTMLElement).style.right = "0";
              }
            });
            
            dropdown.addEventListener("click", e => e.stopPropagation());
          }
        });
      })();

      // Language auto-detect on first visit (homepage only)
      (() => {
        if (localStorage.getItem('preferred-lang')) return;
        const path = window.location.pathname;
        if (path !== '/' && path !== '/index.html') return;
        const browserLang = navigator.language || navigator.languages?.[0] || '';
        if (browserLang.startsWith('pl')) {
          localStorage.setItem('preferred-lang', 'pl');
          window.location.href = '/pl/';
        } else {
          localStorage.setItem('preferred-lang', 'en');
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Import all CSS files in the correct order */
  @import "../styles/terminal.css";
  @import "../styles/fonts.css";
  @import "../styles/main.css";
  @import "../styles/header.css";
  @import "../styles/menu.css";
  @import "../styles/footer.css";
  @import "../styles/buttons.css";
  @import "../styles/post.css";
  @import "../styles/pagination.css";
  @import "../styles/code.css";
  @import "../styles/syntax.css";
  @import "../styles/gist.css";
  @import "../styles/terms.css";

  .header__controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang-switch {
    padding: 0.25rem 0.5rem;
    border: 2px solid var(--accent);
    background: var(--background);
    color: var(--accent);
    font-family: inherit;
    font-size: var(--font-size);
    font-weight: 400;
    line-height: var(--line-height);
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .lang-switch:hover {
    background: var(--accent);
    color: var(--background);
  }
</style>
