---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { useTranslations } from '../i18n/utils';
import { defaultLang, type Lang } from '../i18n/ui';

export interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  image?: string;
  avifImage?: string;
  tags?: string[];
  lang?: Lang;
}

const lang = (Astro.currentLocale || defaultLang) as Lang;
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, author, image, avifImage, tags = [] } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <article>
    <h1 class="post-title">{title}</h1>
    
    <div class="post-meta">
      <time>
        <FormattedDate date={pubDate} lang={lang} />
      </time>
      {author && (
        <span class="post-author">{author}</span>
      )}
      {updatedDate && (
        <span class="post-updated">
          {t('post.updated')} <FormattedDate date={updatedDate} lang={lang} />
        </span>
      )}
      {tags.length > 0 && (
        <span class="post-tags">
          {tags.map((tag) => (
            <a href={getRelativeLocaleUrl(lang, `tags/${tag}`)}>{tag}</a>
          ))}
        </span>
      )}
    </div>
    
    {image && (
      <figure class="post-cover">
        {avifImage ? (
          <picture>
            <source srcset={avifImage} type="image/avif" />
            <img src={image} alt={title} />
          </picture>
        ) : (
          <img src={image} alt={title} />
        )}
      </figure>
    )}
    
    <div class="post-content">
      <slot />
    </div>
  </article>
  
  <script>
    // Code copy functionality
    document.addEventListener('DOMContentLoaded', () => {
      const codeBlocks = document.querySelectorAll('pre.astro-code');
      
      codeBlocks.forEach((block) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'highlight';
        block.parentNode?.insertBefore(wrapper, block);
        wrapper.appendChild(block);
        
        const lang = block.getAttribute('data-language') || 'text';
        
        const titleDiv = document.createElement('div');
        titleDiv.className = 'code-title';
        titleDiv.textContent = lang;
        
        if (navigator.clipboard) {
          const button = document.createElement('button');
          button.className = 'copy-button';
          button.textContent = document.documentElement.lang === 'pl' ? 'Kopiuj' : 'Copy';
          
          button.addEventListener('click', async () => {
            const code = block.textContent || '';
            const isPl = document.documentElement.lang === 'pl';
            try {
              await navigator.clipboard.writeText(code);
              button.textContent = isPl ? 'Skopiowano' : 'Copied';
              setTimeout(() => {
                button.textContent = isPl ? 'Kopiuj' : 'Copy';
              }, 1000);
            } catch (err) {
              console.error('Failed to copy:', err);
            }
          });
          
          titleDiv.appendChild(button);
        }
        
        wrapper.insertBefore(titleDiv, block);
      });
    });
  </script>
  
  <!-- Twitter embed script -->
  <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
</BaseLayout>
